# Example config for the hermes-go agent framework.
# Copy to config.yaml and fill in real values. config.yaml is gitignored.

agent:
  name: hermes
  system_prompt: |
    You are Hermes, a helpful AI assistant.
    You can read/write files, search content, and execute shell commands.
    Be concise and direct. Use tools when needed.

llm:
  provider: xiaomi
  model: mimo-v2.5-pro
  # NEVER commit a real key. Prefer the OPENAI_API_KEY env var.
  api_key: ""
  base_url: https://token-plan-cn.xiaomimimo.com/v1
  max_tokens: 4096
  temperature: 0.7
  max_rounds: 20

store:
  driver: sqlite
  dsn: ~/.hermes/data/hermes.db

skills:
  - terminal
