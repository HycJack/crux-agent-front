# Crux Chat - Environment Configuration
# Copy to .env and fill in real values. .env is gitignored — never commit real keys.

# ── Required ────────────────────────────────────────────────────────────
# JWT signing secret. The server REFUSES TO START without it.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# OpenAI-compatible API settings.
# Optional — you can also configure providers at runtime from the Settings UI.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ── Server ──────────────────────────────────────────────────────────────
LISTEN_ADDR=:8080
UPLOAD_DIR=./uploads

# Comma-separated list of allowed browser origins, e.g.
#   CORS_ORIGINS=http://localhost:3000
# Leave empty to allow all origins (fine for local dev, avoid in production).
CORS_ORIGINS=

# ── Frontend (build-time, must be in frontend/.env) ─────────────────────
# Leave empty to use same-origin requests (recommended behind a reverse proxy).
# VITE_API_BASE=http://localhost:8080
